@model IEnumerable<Discounts.Web.Models.Admin.CategoryViewModel>
@{
    ViewData["Title"] = "Categories Management";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-tags"></i> Categories Management</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add New Category
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No categories found. Click "Add New Category" to create one.</div>
    }
    else
    {
        <table class="table table-hover border">
            <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Category Name</th>
                <th class="text-end">Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td class="fw-bold">@item.Name</td>
                    <td class="text-end">
                        <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-dark">
                            Edit
                        </a>

                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Are you sure you want to delete the @item.Name category?');">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
