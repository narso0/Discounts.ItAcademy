@model IEnumerable<Discounts.Web.Models.Merchant.SalesHistoryViewModel>

@{
    ViewData["Title"] = "Sales History";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-graph-up-arrow text-success"></i> Sales History</h2>
        <a asp-controller="Merchant" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="alert alert-info m-4 text-center shadow-sm">
                    <h4><i class="bi bi-inbox"></i> No sales yet.</h4>
                    <p class="mb-0">When customers purchase your offers, their details and coupon codes will appear here.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="ps-4">Offer Title</th>
                                <th>Customer Email (მომხმარებელი)</th>
                                <th>Date (თარიღი)</th>
                                <th>Coupon Code (კოდი)</th>
                                <th class="text-end pe-4">Revenue</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sale in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">@sale.DiscountTitle</td>
                                    <td><a href="mailto:@sale.CustomerEmail" class="text-decoration-none">@sale.CustomerEmail</a></td>
                                    <td>@sale.TransactionDate.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                                    <td>
                                        <span class="badge bg-light text-dark border font-monospace fs-6 tracking-wide">
                                            @sale.CouponCode
                                        </span>
                                    </td>
                                    <td class="text-end pe-4 text-success fw-bold">
                                        @sale.PricePaid.ToString("C")
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="4" class="text-end fw-bold">Total Revenue:</td>
                                <td class="text-end pe-4 fw-bold text-success fs-5">
                                    @Model.Sum(m => m.PricePaid).ToString("C")
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
