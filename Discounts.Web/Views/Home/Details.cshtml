@model Discounts.Web.Models.Home.StorefrontDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4 mb-5">
    <div class="mb-4">
        <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted fw-bold">
            <i class="bi bi-arrow-left"></i> Back to Offers
        </a>
    </div>

    <div class="card shadow-lg border-0 overflow-hidden">
        <div class="row g-0">
            <div class="col-md-6 bg-light d-flex align-items-center justify-content-center border-end">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="img-fluid w-100 h-100" style="object-fit: cover; min-height: 400px;" alt="@Model.Title">
                }
                else
                {
                    <i class="bi bi-image text-muted" style="font-size: 5rem;"></i>
                }
            </div>
            <div class="col-md-6 p-5 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="badge bg-secondary fs-6 p-2">@Model.CategoryName</span>
                    <span class="text-muted small"><i class="bi bi-shop"></i> @Model.MerchantName</span>
                </div>

                <h1 class="display-6 fw-bold text-dark mb-3">@Model.Title</h1>

                <p class="lead text-muted mb-4">@Model.Description</p>

                <div class="mt-auto">
                    <div class="bg-light rounded p-4 mb-4 border border-2 border-primary border-opacity-25">
                        <div class="row align-items-center">
                            <div class="col-6 border-end">
                                <span class="text-muted d-block small fw-bold text-uppercase tracking-wide">Discount Price</span>
                                <h2 class="text-success fw-bold mb-0">@Model.DiscountedPrice.ToString("C")</h2>
                                <span class="text-decoration-line-through text-muted small">@Model.OriginalPrice.ToString("C")</span>
                            </div>
                            <div class="col-6 text-center">
                                <span class="text-muted d-block small fw-bold text-uppercase tracking-wide">Status</span>
                                @if (Model.QuantityAvailable > 0)
                                {
                                    <h4 class="text-info fw-bold mb-0">@Model.QuantityAvailable Left</h4>
                                    <span class="small text-muted">Ends: @Model.EndDate.ToString("MMM dd")</span>
                                }
                                else
                                {
                                    <h4 class="text-danger fw-bold mb-0">Sold Out</h4>
                                }
                            </div>
                        </div>
                    </div>
                    <form asp-controller="Home" asp-action="Reserve" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow-sm" @(Model.QuantityAvailable <= 0 ? "disabled" : "")>
                            <i class="bi bi-cart-check-fill"></i> Reserve This Offer Now
                        </button>
                    </form>
                    <p class="text-center text-muted small mt-3">
                        <i class="bi bi-shield-lock"></i> Reserving locks this offer for you. Payment happens at the merchant.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
