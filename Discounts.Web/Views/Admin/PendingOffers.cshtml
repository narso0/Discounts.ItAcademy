@model IEnumerable<Discounts.Web.Models.Admin.PendingOfferViewModel>

@{
    ViewData["Title"] = "Pending Offers Moderation";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-clock-history text-warning"></i> Pending Offers Moderation</h2>
    </div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="alert alert-info mb-0">
                    <i class="bi bi-check-circle"></i> Queue is empty. No pending offers require moderation at this time.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Merchant</th>
                                <th>Offer Details</th>
                                <th>Price (Orig / Disc)</th>
                                <th>Duration</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">@item.MerchantName</td>
                                    <td>
                                        <strong>@item.Title</strong><br />
                                        <span class="badge bg-secondary">Cat: @item.CategoryName</span>
                                        <span class="badge bg-info text-dark">Qty: @item.Quantity</span>
                                    </td>
                                    <td>
                                        <span class="text-decoration-line-through text-muted small">@item.OriginalPrice.ToString("C")</span><br />
                                        <strong class="text-success">@item.DiscountedPrice.ToString("C")</strong>
                                    </td>
                                    <td class="small">
                                        <div><strong>Start:</strong> @item.StartDate.ToString("g")</div>
                                        <div><strong>End:</strong> @item.EndDate.ToString("g")</div>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <form asp-controller="Admin" asp-action="ApproveOffer" method="post">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-success">
                                                    <i class="bi bi-check-lg"></i> Approve
                                                </button>
                                            </form>
                                            <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal-@item.Id">
                                                <i class="bi bi-x-lg"></i> Reject
                                            </button>

                                        </div>
                                        <div class="modal fade text-start" id="rejectModal-@item.Id" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header bg-danger text-white">
                                                        <h5 class="modal-title">Reject Offer: @item.Title</h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                    </div>

                                                    @*REFECT FORM below, i need to indicate this, because a person can get lost in this ugly file*@
                                                    <form asp-controller="Admin" asp-action="RejectOffer" method="post">
                                                        <div class="modal-body">
                                                            <div class="alert alert-warning small">
                                                                Rejecting this offer will keep it offline. The merchant will see your reason and must resubmit it.
                                                            </div>
                                                            <input type="hidden" name="id" value="@item.Id" />
                                                            <div class="mb-3">
                                                                <label for="rejectionReason-@item.Id" class="form-label fw-bold">Reason for Rejection</label>
                                                                <textarea id="rejectionReason-@item.Id" name="rejectionReason" class="form-control" rows="3" required placeholder="e.g., 'Discounted price cannot be higher than original price.'"></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-danger">Confirm Rejection</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
