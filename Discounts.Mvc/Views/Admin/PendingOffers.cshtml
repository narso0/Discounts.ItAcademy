@model IEnumerable<Discounts.Web.Models.Admin.PendingOfferViewModel>

@{
    ViewData["Title"] = "Pending Offers Moderation";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary"><i class="bi bi-clock-history"></i> Pending Offers Moderation</h2>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="alert alert-light m-4 border shadow-sm">
                    <i class="bi bi-check-circle text-success"></i> <span class="text-muted">Queue is empty. No pending offers require moderation at this time.</span>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted">
                            <tr>
                                <th class="ps-4">Merchant</th>
                                <th>Offer Details</th>
                                <th>Price (Orig / Disc)</th>
                                <th>Duration</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-dark ps-4">@item.MerchantName</td>
                                    <td>
                                        <strong>@item.Title</strong><br />
                                        <span class="badge bg-light text-dark border">Cat: @item.CategoryName</span>
                                        <span class="badge bg-light text-primary border">Qty: @item.Quantity</span>
                                    </td>
                                    <td>
                                        <span class="text-decoration-line-through text-muted small">@item.OriginalPrice.ToString("C")</span><br />
                                        <strong class="text-success">@item.DiscountedPrice.ToString("C")</strong>
                                    </td>
                                    <td class="small text-muted">
                                        <div><strong>Start:</strong> @item.StartDate.ToString("g")</div>
                                        <div><strong>End:</strong> @item.EndDate.ToString("g")</div>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-2">
                                            <form asp-controller="Admin" asp-action="ApproveOffer" method="post" class="m-0">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-primary shadow-sm px-3">
                                                    <i class="bi bi-check-lg"></i> Approve
                                                </button>
                                            </form>
                                            <button type="button" class="btn btn-sm btn-outline-danger shadow-sm px-3" data-bs-toggle="modal" data-bs-target="#rejectModal-@item.Id">
                                                <i class="bi bi-x-lg"></i> Reject
                                            </button>
                                        </div>

                                        <div class="modal fade text-start" id="rejectModal-@item.Id" tabindex="-1">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content border-0 shadow">
                                                    <div class="modal-header bg-light border-bottom-0">
                                                        <h5 class="modal-title text-danger fw-bold">Reject Offer: @item.Title</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <form asp-controller="Admin" asp-action="RejectOffer" method="post">
                                                        <div class="modal-body pt-0">
                                                            <p class="text-muted small mb-3">
                                                                Rejecting this offer keeps it offline. The merchant will see your reason and must resubmit.
                                                            </p>
                                                            <input type="hidden" name="id" value="@item.Id" />
                                                            <div class="mb-3">
                                                                <label for="rejectionReason-@item.Id" class="form-label fw-bold text-dark">Reason for Rejection</label>
                                                                <textarea id="rejectionReason-@item.Id" name="rejectionReason" class="form-control bg-light" rows="3" required placeholder="e.g., 'Discounted price cannot be higher than original price.'"></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer border-top-0">
                                                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-danger px-4 shadow-sm">Confirm Rejection</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
