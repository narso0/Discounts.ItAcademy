@using Discounts.Domain.Entities
@model IEnumerable<Merchant>

@{
    ViewData["Title"] = "Pending Merchants";
}

<div class="container mt-5">
    <h2 class="mb-4 text-primary"><i class="bi bi-shop"></i> Pending Merchant Approvals</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-light border shadow-sm" role="alert">
            <h5 class="alert-heading text-success"><i class="bi bi-check-circle-fill"></i> All caught up!</h5>
            <p class="text-muted mb-0">There are currently no merchants waiting for approval.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted">
                        <tr>
                            <th>Business Name</th>
                            <th>Email</th>
                            <th>Contact Number</th>
                            <th>Description</th>
                            <th>Applied On</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var merchant in Model)
                        {
                            <tr>
                                <td class="fw-bold">@merchant.Name</td>
                                <td><a href="mailto:@merchant.Email" class="text-decoration-none">@merchant.Email</a></td>
                                <td>@merchant.Number</td>
                                <td class="text-muted"><small>@merchant.Description</small></td>
                                <td>@merchant.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td class="text-end">
                                    <form asp-controller="Admin" asp-action="ApproveMerchant" asp-route-id="@merchant.Id" method="post" class="m-0">
                                        <button type="submit" class="btn btn-outline-primary btn-sm shadow-sm px-3">
                                            <i class="bi bi-check2-circle"></i> Approve
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
